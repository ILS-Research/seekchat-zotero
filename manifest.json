{
  "manifest_version": 2,
  "name": "SeekChatZot",
  "version": "0.0.0",
  "description": "Chat with your PDFs in Zotero using a self-hosted LLM (Ollama or OpenAI-compatible).",
  "author": "ILS",
  "homepage_url": "https://gitlab.com/ils-research/zotero-plugins/seekchat-zotero",
  "icons": {
    "48": "content/icons/seekchat.svg",
    "96": "content/icons/seekchat.svg"
  },
  "applications": {
    "zotero": {
      "id": "seekchat@ils-forschung.de",
      "update_url": "https://gitlab.com/ils-research/zotero-plugins/seekchat-zotero/-/raw/master/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.0.*"
    }
  }
}
